# Copy to .env and fill in. Never commit .env.

# ---- Embeddings: "local" (free, fastembed) or "azure" ----
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Chat model: "openai_compatible" (Ollama/Groq/etc.) or "azure" ----
LLM_PROVIDER=openai_compatible

# openai_compatible example: Ollama running locally (https://ollama.com, `ollama pull llama3.2`)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# ---- Vector store: "local" (numpy) or "azure_search" ----
VECTOR_STORE=local
SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
SEARCH_API_KEY=
SEARCH_INDEX_NAME=rag-chunks
USE_SEMANTIC_RANKER=false
# Similarity threshold depends on the embedding model: ~0.52 for local bge-small, ~0.23 for Azure text-embedding-3-small
MIN_SCORE=0.23

# ---- Azure OpenAI (fill in when your account works) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
